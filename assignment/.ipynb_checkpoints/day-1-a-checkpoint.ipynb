    "    numbers.append(num)\n",
    "\n",
    "print(\"List:\", numbers)\n",
    "\n",
    "print(\"Even numbers:\")\n",
    "\n",
    "for num in numbers:\n",
    "    if num % 2 == 0:\n",
    "        print(num)"
